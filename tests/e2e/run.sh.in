#!/usr/bin/env bash
# End-to-end test: crafted packets over a real routed path, through the real
# inspector, with the real iptables rules.
#
#   sudo ./e2e/run.sh [-v]
#
# The inspector's rule lives in the FORWARD chain, so loopback traffic would
# never reach it. This builds an actual routed path out of three namespaces:
#
#     pi-e2e-cli                pi-e2e-rtr                pi-e2e-srv
#   ┌────────────┐   veth   ┌──────────────────┐   veth   ┌────────────┐
#   │ e2e_sender ├──────────┤ forwards + rules ├──────────┤e2e_receiver│
#   │ 10.99.1.x  │          │ .1.1        .2.1 │          │ 10.99.2.2  │
#   └────────────┘          └────────┬─────────┘          └────────────┘
#                                    │ NFQUEUE
#                              PacketInspector
#
# The sender injects crafted frames straight onto the veth, so no local TCP
# stack is involved and sequence numbers, flags and ordering are exactly what
# the corpus says. The receiver sniffs the far side and checks, per packet,
# whether it arrived -- which is precisely the question the inspector answers.
#
# The whole corpus runs twice: once with a single worker on one queue, and once
# with four workers behind --queue-balance. The second run is what exercises
# flow affinity: each case uses its own source address, so cases spread across
# queues, and a split ClientHello is only ever reassembled if every one of its
# segments reached the same worker.
#
# Addresses, rules and processes all live inside those namespaces, so this never
# touches the host's networking or firewall.
#
# Requires root: creating namespaces and veth pairs, and writing iptables rules.
set -euo pipefail

INSPECTOR="@PACKETINSPECTOR_BIN@"
SENDER="@E2E_SENDER_BIN@"
RECEIVER="@E2E_RECEIVER_BIN@"
NFQUEUE_SH="@NFQUEUE_SH@"

CLI_NS=pi-e2e-cli
RTR_NS=pi-e2e-rtr
SRV_NS=pi-e2e-srv

# veth pair names. The router end of each carries the .1 address.
CLI_IF=vcli
RTR_CLI_IF=vrtrc
SRV_IF=vsrv
RTR_SRV_IF=vrtrs

CLI_NET4=10.99.1
SRV_IP4=10.99.2.2
RTR_CLI_IP4=10.99.1.1
RTR_SRV_IP4=10.99.2.1

CLI_NET6=fd00:99:1
SRV_IP6=fd00:99:2::2
RTR_CLI_IP6=fd00:99:1::1
RTR_SRV_IP6=fd00:99:2::1

# How long the receiver captures. Has to clear the inspector's ~10s idle sweep,
# which one case deliberately waits on.
CAPTURE_SECONDS=18

VERBOSE=0
[[ "${1:-}" == "-v" ]] && VERBOSE=1

BLOCKLIST=""
FAILURES=0

# --- output ---------------------------------------------------------------

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
info()  { printf '\033[36m==>\033[0m %s\n' "$*"; }

# --- preflight ------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
  red "must run as root: this creates network namespaces and iptables rules"
  exit 1
fi

for bin in "$INSPECTOR" "$SENDER" "$RECEIVER" "$NFQUEUE_SH"; do
  if [[ ! -x "$bin" ]]; then
    red "not built or not executable: $bin"
    exit 1
  fi
done

for tool in ip iptables ip6tables; do
  command -v "$tool" >/dev/null || { red "missing required tool: $tool"; exit 1; }
done

# --- topology -------------------------------------------------------------

# Namespaces only. Deliberately separate from the blocklist, which outlives
# every suite -- setup_topology() calls this between runs, and folding the two
# together would delete the blocklist out from under the second run.
teardown_ns() {
  set +e
  ip netns del "$CLI_NS" 2>/dev/null
  ip netns del "$RTR_NS" 2>/dev/null
  ip netns del "$SRV_NS" 2>/dev/null
  set -e
}

teardown() {
  teardown_ns
  [[ -n "$BLOCKLIST" ]] && rm -f "$BLOCKLIST"
}
trap teardown EXIT

setup_topology() {
  teardown_ns

  ip netns add "$CLI_NS"
  ip netns add "$RTR_NS"
  ip netns add "$SRV_NS"

  ip link add "$CLI_IF" type veth peer name "$RTR_CLI_IF"
  ip link add "$SRV_IF" type veth peer name "$RTR_SRV_IF"
  ip link set "$CLI_IF"     netns "$CLI_NS"
  ip link set "$RTR_CLI_IF" netns "$RTR_NS"
  ip link set "$SRV_IF"     netns "$SRV_NS"
  ip link set "$RTR_SRV_IF" netns "$RTR_NS"

  # Client: one address for the stack's benefit; the sender spoofs the rest of
  # the /24 itself, which is how cases get spread over queues.
  ip -n "$CLI_NS" addr add "$CLI_NET4.2/24"  dev "$CLI_IF"
  ip -n "$CLI_NS" addr add "$CLI_NET6::2/64" dev "$CLI_IF" nodad
  ip -n "$CLI_NS" link set "$CLI_IF" up
  ip -n "$CLI_NS" link set lo up
  ip -n "$CLI_NS" route add default via "$RTR_CLI_IP4"
  ip -n "$CLI_NS" -6 route add default via "$RTR_CLI_IP6"

  ip -n "$RTR_NS" addr add "$RTR_CLI_IP4/24" dev "$RTR_CLI_IF"
  ip -n "$RTR_NS" addr add "$RTR_CLI_IP6/64" dev "$RTR_CLI_IF" nodad
  ip -n "$RTR_NS" addr add "$RTR_SRV_IP4/24" dev "$RTR_SRV_IF"
  ip -n "$RTR_NS" addr add "$RTR_SRV_IP6/64" dev "$RTR_SRV_IF" nodad
  ip -n "$RTR_NS" link set "$RTR_CLI_IF" up
  ip -n "$RTR_NS" link set "$RTR_SRV_IF" up
  ip -n "$RTR_NS" link set lo up

  ip -n "$SRV_NS" addr add "$SRV_IP4/24" dev "$SRV_IF"
  ip -n "$SRV_NS" addr add "$SRV_IP6/64" dev "$SRV_IF" nodad
  ip -n "$SRV_NS" link set "$SRV_IF" up
  ip -n "$SRV_NS" link set lo up
  ip -n "$SRV_NS" route add default via "$RTR_SRV_IP4"
  ip -n "$SRV_NS" -6 route add default via "$RTR_SRV_IP6"

  ip netns exec "$RTR_NS" sysctl -qw net.ipv4.ip_forward=1
  ip netns exec "$RTR_NS" sysctl -qw net.ipv6.conf.all.forwarding=1
  # The sender uses many source addresses from the client subnet. They are all
  # legitimately reachable that way, but turn strict reverse-path filtering off
  # so a kernel default cannot silently eat them and look like a DROP.
  ip netns exec "$RTR_NS" sysctl -qw net.ipv4.conf.all.rp_filter=0
  ip netns exec "$RTR_NS" sysctl -qw net.ipv4.conf.default.rp_filter=0
  ip netns exec "$RTR_NS" sysctl -qw "net.ipv4.conf.$RTR_CLI_IF.rp_filter=0"

  # Populate ARP and NDP before any test traffic. The router has to resolve the
  # server's address to forward, and a first packet lost to that lookup would
  # look exactly like the inspector dropping it.
  ip netns exec "$RTR_NS" ping -c1 -W2 "$SRV_IP4"  >/dev/null 2>&1 || true
  ip netns exec "$RTR_NS" ping -c1 -W2 "$SRV_IP6"  >/dev/null 2>&1 || true
  ip netns exec "$CLI_NS" ping -c1 -W2 "$RTR_CLI_IP4" >/dev/null 2>&1 || true
  ip netns exec "$CLI_NS" ping -c1 -W2 "$RTR_CLI_IP6" >/dev/null 2>&1 || true

  # Verify the path actually forwards before blaming the inspector for anything.
  if ! ip netns exec "$CLI_NS" ping -c1 -W2 "$SRV_IP4" >/dev/null 2>&1; then
    red "IPv4 path is not forwarding; the topology is broken, not the inspector"
    exit 1
  fi
  if ! ip netns exec "$CLI_NS" ping -c1 -W2 "$SRV_IP6" >/dev/null 2>&1; then
    red "IPv6 path is not forwarding; the topology is broken, not the inspector"
    exit 1
  fi
}

write_blocklist() {
  BLOCKLIST="$(mktemp /tmp/pi-e2e-blocklist.XXXXXX)"
  cat >"$BLOCKLIST" <<'EOF'
# Written by tests/e2e/run.sh. Must match the hostnames in e2e_cases.hpp.
blocked.e2e.test
*.wild.e2e.test
EOF
}

# --- one run of the corpus at a given worker count ------------------------

run_suite() {
  local workers="$1"
  local queue_last=$((workers - 1))

  info "running corpus with $workers worker(s) on queue(s) 0..$queue_last"

  setup_topology

  # The production rule installer, used exactly as a real deployment would.
  if [[ $VERBOSE -eq 1 ]]; then
    ip netns exec "$RTR_NS" env WORKERS="$workers" "$NFQUEUE_SH" up 0 "$workers"
  else
    ip netns exec "$RTR_NS" env WORKERS="$workers" "$NFQUEUE_SH" up 0 "$workers" \
      >/dev/null
  fi

  local insp_log rcv_log
  insp_log="$(mktemp /tmp/pi-e2e-inspector.XXXXXX)"
  rcv_log="$(mktemp /tmp/pi-e2e-receiver.XXXXXX)"

  # Inspector first, so every queue in the range has a listener before a single
  # packet is hashed to one. A queue with no listener would be bypassed and its
  # share of the traffic would go through uninspected.
  ip netns exec "$RTR_NS" "$INSPECTOR" \
      -j "$workers" -nfq 0 -b "$BLOCKLIST" --stats 5 -v \
      >"$insp_log" 2>&1 &
  local insp_pid=$!

  # Wait for it to actually bind, rather than guessing with a sleep.
  local waited=0
  until grep -q "iptables must route" "$insp_log" 2>/dev/null; do
    sleep 0.1
    waited=$((waited + 1))
    if [[ $waited -gt 100 ]]; then
      red "inspector did not start within 10s"
      cat "$insp_log"
      kill "$insp_pid" 2>/dev/null || true
      FAILURES=$((FAILURES + 1))
      rm -f "$insp_log" "$rcv_log"
      return
    fi
  done
  if ! kill -0 "$insp_pid" 2>/dev/null; then
    red "inspector exited immediately"
    cat "$insp_log"
    FAILURES=$((FAILURES + 1))
    rm -f "$insp_log" "$rcv_log"
    return
  fi
  sleep 0.3 # let all N queues finish binding

  # Receiver before sender, or the first packets are missed.
  ip netns exec "$SRV_NS" "$RECEIVER" \
      --iface "$SRV_IF" --seconds "$CAPTURE_SECONDS" >"$rcv_log" 2>&1 &
  local rcv_pid=$!
  sleep 0.5

  local gw_mac
  gw_mac="$(ip -n "$RTR_NS" -br link show dev "$RTR_CLI_IF" | awk '{print $3}')"
  ip netns exec "$CLI_NS" "$SENDER" --iface "$CLI_IF" --dst-mac "$gw_mac" \
    || { red "sender failed"; FAILURES=$((FAILURES + 1)); }

  local rcv_rc=0
  wait "$rcv_pid" || rcv_rc=$?

  kill "$insp_pid" 2>/dev/null || true
  wait "$insp_pid" 2>/dev/null || true

  cat "$rcv_log"

  if [[ $rcv_rc -ne 0 ]]; then
    red "corpus FAILED with $workers worker(s)"
    FAILURES=$((FAILURES + 1))
    info "inspector log:"
    cat "$insp_log"
  else
    green "corpus passed with $workers worker(s)"
    if [[ $VERBOSE -eq 1 ]]; then
      info "inspector log:"
      cat "$insp_log"
    fi
  fi

  # An undecided packet is always a bug, even when every expectation held.
  if grep -q "undecided=[1-9]" "$insp_log"; then
    red "inspector reported undecided packets (a callback dropped one)"
    grep "undecided=[1-9]" "$insp_log" | tail -3
    FAILURES=$((FAILURES + 1))
  fi

  rm -f "$insp_log" "$rcv_log"
}

# --- go -------------------------------------------------------------------

write_blocklist

# One worker: a single queue, --queue-num, no hashing involved.
run_suite 1

# Four workers: --queue-balance across four queues. Cases are spread by source
# address, so this is what proves a flow's segments all reach one reassembler.
run_suite 4

echo
if [[ $FAILURES -eq 0 ]]; then
  green "e2e: all suites passed"
  exit 0
fi
red "e2e: $FAILURES suite(s) failed"
exit 1
