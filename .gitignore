# Build output.
# Everything here is regenerated by:
#   cmake -B build && cmake --build build
build/
build-*/
cmake-build-*/

# CMake leftovers, for anyone who configures in-tree instead of with -B.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Testing/
Makefile

# Compile database. CMAKE_EXPORT_COMPILE_COMMANDS is on, so CMake writes it
# into the build directory; editors usually want a copy or symlink at the root.
compile_commands.json

# clangd's index. Large, machine-specific, and rebuilt on demand.
.cache/

# Compiled artefacts, in case anything is ever built by hand.
*.o
*.a
*.so
*.so.*
*.d

# Old code kept around locally. Delete this line if you do want it in the repo.
.bak/

# Crash dumps.
core
core.*
vgcore.*

# Editor and operating system noise.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# NOTE: bench/ has its own .gitignore, because the benchmark's throwaway files
# (an 825 MB traffic generator, and results directories) are specific to it.
